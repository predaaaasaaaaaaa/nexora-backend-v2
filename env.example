# AI API
GROQ_API_KEY=your-groq-key-here

# Server
PORT=3001
NODE_ENV=development

# Supabase (Get from: https://supabase.com → Project Settings → API)
SUPABASE_URL=https://xxxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Youtube
YOUTUBE_CLIENT_ID=your-client-id-here
YOUTUBE_CLIENT_SECRET=your-client-secret-here
YOUTUBE_API_KEY=your-api-key-here
YOUTUBE_REDIRECT_URI=

# OAuth state HMAC secret (>= 32 random chars). Used to bind OAuth callbacks
# to the user that started the flow.
OAUTH_STATE_SECRET=

# Paddle checkout HMAC secret (>= 32 random chars). The frontend opens
# checkout with custom_data.user_id_signed minted server-side using this
# secret; the webhook only trusts user IDs that verify.
CHECKOUT_USER_ID_SECRET=

# 32-byte symmetric key used to encrypt third-party OAuth tokens at rest.
# Provide as 64 hex chars or 44 base64 chars. Generate, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=

# Upstash Redis REST credentials — required in production for the rate
# limiter to share state across Vercel instances. Without these, prod
# rate limits are per-instance and effectively useless.
# Create at https://console.upstash.com/redis (free tier is enough).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Supabase JWT secret. With this set, requireAuth verifies the token
# locally (no network round-trip per request). Find it at
# Supabase dashboard → Settings → API → JWT Settings → JWT Secret.
# Treat it like SUPABASE_SERVICE_KEY: anyone with this can forge
# user JWTs.
SUPABASE_JWT_SECRET=

# Set to 'true' to periodically re-verify JWTs against Supabase Auth
# (catches revocation faster). Off by default — local verify trusts
# the JWT until natural expiry (~1 hour for Supabase defaults).
REQUIRE_AUTH_FRESH_CHECK=false
JWT_REFRESH_CHECK_MS=300000

# When true (default), API rejects users whose Supabase email is not
# confirmed. Set to 'false' only if you have a legacy population that
# signed up before this gate was enforced.
REQUIRE_EMAIL_VERIFICATION=true

# Cloudflare Turnstile secret for the signup CAPTCHA. Without this,
# signup is unprotected and a botnet can mint Free accounts to harvest
# AI quota. https://dash.cloudflare.com → Turnstile → New site (free).
TURNSTILE_SECRET=

# How many days a 'past_due' subscription keeps paid features before
# being treated as 'free'. Set to 0 to downgrade immediately on
# payment failure.
PAST_DUE_GRACE_DAYS=3

# Context cache TTL — how long getUserContext keeps the assembled
# user/profile/analytics object in memory before refreshing.
CONTEXT_CACHE_TTL_MS=60000

# Per-user monthly YouTube API quota caps. Defaults sized so 100 active
# Pro users + 50 active Max users stay well under the project's
# 10,000 units/day default. Raise if you bump the project quota at
# Google Cloud Console.
YT_QUOTA_PRO=2000
YT_QUOTA_MAX=10000

# Number of trusted proxy hops in front of the API. Vercel alone = 1.
# Vercel + Cloudflare in front = 2. Setting this WRONG enables IP
# spoofing via X-Forwarded-For — confirm by inspecting prod logs.
TRUST_PROXY_HOPS=1
